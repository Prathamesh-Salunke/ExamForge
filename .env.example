# ExamForge Environment Configuration (Placeholders)
# Copy this file to .env.local to configure Supabase Cloud Authentication

# Supabase Project URL & Anonymous Public Key (Optional - application seamlessly falls back to Institutional College Auth if not set)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Application Settings
VITE_APP_TITLE="ExamForge"
VITE_APP_INSTITUTION="College of Engineering & Technology"
VITE_ENABLE_DSATUR=true
VITE_DEFAULT_SESSION="Spring 2026"
